{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "noImplicitAny": true,

    "paths": {
      "@prisma/client": ["./src/generated/prisma/client"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/scripts/check-vendor-sales.ts",
    "src/scripts/check_banca_population.ts",
    "src/scripts/check_sup_cols.ts",
    "src/scripts/debug-rules.ts",
    "src/scripts/debug_rules.ts",
    "src/scripts/diag-restriction.ts",
    "src/scripts/diagnose-account-statements.ts",
    "src/scripts/diagnose-monthly-accumulated.ts",
    "src/scripts/find-sorteo.ts",
    "src/scripts/migrate-account-payments-to-correct-statements.ts",
    "src/scripts/recalculate-accumulated-balance.ts",
    "src/scripts/repro-dynamic-limit.ts",
    "src/scripts/restore_rules.ts",
    "src/scripts/test-replica.ts",
    "src/scripts/verify-listas.ts",
    "src/scripts/verify-month-ventana-data.ts",
    "src/scripts/verify-recalculate-account-statements.ts",
    "src/scripts/verify-vendedor-limits.ts"
  ]
}
